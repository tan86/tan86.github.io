{
  "name": "commit-header",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    }
  },
  "quartz": {
    "name": "commit-header",
    "displayName": "Commit Header",
